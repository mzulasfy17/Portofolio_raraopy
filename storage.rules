rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Pengunjung website boleh melihat dan mengunduh foto & dokumen CV
    // Hanya Admin yang terautentikasi (request.auth != null) yang boleh mengunggah atau menghapus file
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
