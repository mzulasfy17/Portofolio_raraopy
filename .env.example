# =========================================================================
# VITE ENVIRONMENT VARIABLES (TEMPLATE PORTOFOLIO RAHMA)
# =========================================================================
# File ini berfungsi sebagai panduan/template variabel lingkungan (env).
# Jangan memasukkan API Key asli di file ini jika di-commit ke GitHub.
#
# CARA PENGGUNAAN:
# 1. Salin/Buat file bernama `.env` di folder utama proyek (root directory)
# 2. Isi nilai VITE_EMAILJS_... di bawah dengan Key milikmu dari https://www.emailjs.com/
# =========================================================================

# 1. EmailJS Configuration (Disarankan untuk kirim email langsung ke Inbox)
# Daftar gratis di https://www.emailjs.com/ -> Create Email Service (Gmail) -> Create Template -> Get Public Key
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# 2. Web3Forms Configuration (Alternatif tanpa template)
# Daftar gratis di https://web3forms.com/ untuk mendapatkan Access Key langsung via email
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
