# =========================================================================
# VITE ENVIRONMENT VARIABLES (TEMPLATE PORTOFOLIO RAHMA)
# =========================================================================
# File ini berfungsi sebagai panduan/template variabel lingkungan (env).
# Jangan memasukkan API Key asli di file ini jika di-commit ke GitHub.
#
# CARA PENGGUNAAN:
# 1. Salin/Buat file bernama `.env` di folder utama proyek (root directory)
# 2. Isi nilai VITE_... di bawah sesuai kredensial Anda
# =========================================================================

# 1. Firebase Configuration (Untuk Admin Panel & Firestore Database CRUD)
# Buat project gratis di https://console.firebase.google.com/
# Aktifkan Authentication (Email/Password) & Cloud Firestore Database
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id_here

# 2. EmailJS Configuration (Disarankan untuk kirim email langsung ke Inbox)
# Daftar gratis di https://www.emailjs.com/ -> Create Email Service (Gmail) -> Create Template -> Get Public Key
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# 3. Web3Forms Configuration (Alternatif tanpa template)
# Daftar gratis di https://web3forms.com/ untuk mendapatkan Access Key langsung via email
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
